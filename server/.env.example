# `npm run setup` creates server/.env for you. Edit only if you need something different.
# The database is a single file, relative to server/prisma/.
DATABASE_URL="file:./equaart.db"
# Tests use a separate file (wiped on every run).
TEST_DATABASE_URL="file:./test.db"
PORT=4000
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-secret"
ACCESS_TOKEN_TTL_MIN=15
SESSION_IDLE_MIN=30
SESSION_ABSOLUTE_HOURS=8
CORS_ORIGIN="http://localhost:5173,http://localhost:4000"
# Set to "true" only behind HTTPS.
COOKIE_SECURE=false
