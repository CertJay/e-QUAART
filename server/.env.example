# Copy to .env and adjust.
DATABASE_URL="postgresql://equaart:equaart@localhost:5432/equaart"
# Used by the test suite (tests reset this database).
TEST_DATABASE_URL="postgresql://equaart:equaart@localhost:5432/equaart_test"
PORT=4000
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-secret"
ACCESS_TOKEN_TTL_MIN=15
SESSION_IDLE_MIN=30
SESSION_ABSOLUTE_HOURS=8
CORS_ORIGIN="http://localhost:5173"
# Set to "true" only behind HTTPS.
COOKIE_SECURE=false
